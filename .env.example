# Supabase Configuration
# Obtenha estas credenciais em: https://supabase.com/dashboard/project/_/settings/api

# Project ID do Supabase
VITE_SUPABASE_PROJECT_ID=your-project-id

# URL do Supabase Project
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Chave Pública (Anon Key) - para acesso público
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Instruções:
# 1. Copie este arquivo para .env
# 2. Substitua os valores acima pelas suas credenciais do Supabase
# 3. Nunca commite o arquivo .env para o repositório
# 4. Para Vercel, adicione estas variáveis em Project Settings → Environment Variables
